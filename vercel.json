{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/tradeconnect",
      "destination": "/case-studies/tradeconnect",
      "permanent": true
    },
    {
      "source": "/tradeconnect/",
      "destination": "/case-studies/tradeconnect",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/case-studies/workpulse",
      "destination": "/case-studies/workpulse/index.html"
    },
    {
      "source": "/case-studies/workpulse/",
      "destination": "/case-studies/workpulse/index.html"
    },
    {
      "source": "/case-studies/tiger-fitness",
      "destination": "/case-studies/tiger-fitness/index.html"
    },
    {
      "source": "/case-studies/tiger-fitness/",
      "destination": "/case-studies/tiger-fitness/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
