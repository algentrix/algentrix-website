{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/case-studies/tiger-fitness", "destination": "/case-studies/tiger-fitness/index.html" },
    { "source": "/case-studies/tiger-fitness/", "destination": "/case-studies/tiger-fitness/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
